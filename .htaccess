Options -Indexes
RewriteEngine On

# Route ALL requests (including OPTIONS preflight) through index.php
# PHP handles CORS headers — set before require_once so they always fire
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

# Block direct access to sensitive directories
<DirectoryMatch "logs|migrations">
    Require all denied
</DirectoryMatch>

# Block direct access to sensitive files
<FilesMatch "\.(env|log|sql|sh|txt|bak)$">
    Require all denied
</FilesMatch>

# Security headers
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
