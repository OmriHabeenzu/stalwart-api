Options -Indexes
RewriteEngine On

# Handle OPTIONS preflight at server level — return 200 before PHP runs
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ - [R=200,L]

# Route all requests through index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

# Block direct access to sensitive directories
<DirectoryMatch "logs|migrations">
    Require all denied
</DirectoryMatch>

# Block direct access to sensitive files
<FilesMatch "\.(env|log|sql|sh|txt|bak)$">
    Require all denied
</FilesMatch>

# CORS headers — set at server level so they appear on ALL responses including errors
<IfModule mod_headers.c>
    SetEnvIf Origin "^https://(www\.)?stalwartzm\.com$" CORS_OK=1
    SetEnvIf Origin "^http://localhost(:[0-9]+)?$" CORS_OK=1

    Header always set Access-Control-Allow-Origin "%{HTTP_ORIGIN}e" env=CORS_OK
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
    Header always set Access-Control-Allow-Credentials "true"
</IfModule>

# Security headers for API responses
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
